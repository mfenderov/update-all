#!/usr/bin/env zsh
# update-all - one command for everything. Runs on macOS and Linux.
#
# Usage: update-all [-h|--help]
# Env: UPD_ALL_OS=1                include the machine itself (needs sudo):
#                                  macOS: softwareupdate + mas
#                                  Linux: apt + release-upgrade
#      UPD_ALL_RESTART_SERVICE=1   allow opencode service restart inside an opencode terminal
#
# Policy: every non-interactive section runs with stdin closed. Anything that
# wants confirmation fails fast (red, continue) instead of hanging the run.

emulate -L zsh
setopt pipe_fail 2>/dev/null || setopt pipefail 2>/dev/null || true

# Apple Silicon brew lives outside the default PATH in non-interactive shells
# (launchd, cron, ssh without login). Pick it up when present.
if ! command -v brew >/dev/null && [[ -x /opt/homebrew/bin/brew ]]; then
  export PATH="/opt/homebrew/bin:$PATH"
fi
if ! command -v brew >/dev/null && [[ -x /usr/local/bin/brew ]]; then
  export PATH="/usr/local/bin:$PATH"
fi

_upd_claude_plugins() {
  command -v jq >/dev/null || return 0
  local -a _plugins
  local _list _p _failed=0
  _list=$(claude plugin list --json 2>/dev/null) || return 0
  [[ $_list == '[]' || -z $_list ]] && return 0
  _plugins=(${(f)"$(echo "$_list" | jq -r '.[] | select(.id | test("@inline$|@skills-dir$|@synced$") | not) | .id' 2>/dev/null)"})
  (( ${#_plugins} == 0 )) && return 0
  for _p in "${_plugins[@]}"; do
    [[ -n $_p ]] || continue
    claude plugin update -y "$_p" </dev/null || _failed=1
  done
  return $_failed
}

# Section functions: one behavior each, stdin closed for non-interactive ones.
# Chaining uses && so an early failure is never masked by a later success.
_s_brew()            { { brew update && brew upgrade && brew cleanup; } </dev/null }
_s_omz()             { { zsh "${ZSH:-$HOME/.oh-my-zsh}/tools/upgrade.sh"; } </dev/null }
_s_npm()             { { npm install -g npm && npm update -g; } </dev/null }
_s_bun()             { { bun upgrade && bun update -g; } </dev/null }
_s_rustup()          { { rustup update; } </dev/null }
_s_opencode()        { { opencode update && opencode plugin update; } </dev/null }
_s_opencode_svc()    { { opencode service restart; } </dev/null }
_s_claude()          { { claude update && claude plugin marketplace update && _upd_claude_plugins; } </dev/null }
_s_pi()              { { pi update --all && pi update --models; } </dev/null }
_s_copilot()         { { copilot update && copilot plugin marketplace update && copilot plugin update --all; } </dev/null }
_s_crush()           { { crush update-providers && crush update-providers --source=hyper; } </dev/null }
_s_uv()              { { uv self update && uv tool upgrade --all; } </dev/null }
_s_gh()              { { gh extension upgrade --all; } </dev/null }
_s_pipx()            { { pipx upgrade-all; } </dev/null }
_s_cargo_pkgs()      { { cargo install-update -a; } </dev/null }
# macOS: softwareupdate covers macOS itself, Safari, Xcode CLT and firmware.
# Xcode.app and other App Store apps update via mas. xcode-select --install is
# deliberately absent: it pops a GUI dialog and would hang a headless run.
_s_softwareupdate()  { { sudo softwareupdate -i -a; } </dev/null }
_s_mas()             { { mas upgrade; } </dev/null }
_s_apt()             { { sudo apt update && sudo apt full-upgrade -y && sudo apt autoremove -y; } </dev/null }

_upd_usage() {
  print -- "Usage: update-all [-h|--help]"
  print -- "Updates brew, oh-my-zsh, npm/bun globals, rustup, opencode, claude, pi,"
  print -- "copilot, crush, uv tools, gh extensions, pipx, cargo packages."
  print -- "Env: UPD_ALL_OS=1 includes the machine itself (needs sudo):"
  print -- "       macOS: softwareupdate + mas.  Linux: apt + release-upgrade."
  print -- "     UPD_ALL_RESTART_SERVICE=1 allows service restart inside an opencode terminal."
}

update-all() {
  if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    _upd_usage
    return 0
  fi

  local _c_bold _c_cyan _c_green _c_red _c_reset
  if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-dumb} != dumb ]] && command -v tput >/dev/null; then
    _c_bold=$(tput bold) _c_cyan=$(tput setaf 6) _c_green=$(tput setaf 2) _c_red=$(tput setaf 1) _c_reset=$(tput sgr0)
  fi
  local -a _upd_failed _upd_skipped
  _upd_run() {  # _upd_run <label> <function> [ok-pattern ...]
    local _label=$1 _func=$2 _start=$SECONDS _out _rc _ok=0 _p
    shift 2
    print -- "${_c_bold}${_c_cyan}━━━ ${_label} ━━━${_c_reset}"
    if (( $# > 0 )); then
      if [[ -f /dev/stderr ]]; then
        # stderr is a regular file (e.g. update-all >log 2>&1): tee /dev/stderr
        # would reopen it with an independent offset and clobber the log.
        # Capture first, then replay to stderr.
        _out=$("$_func" 2>&1)
        _rc=$?
        print -r -- "$_out" >&2
      else
        _out=$("$_func" 2>&1 | tee /dev/stderr; exit ${pipestatus[1]})
        _rc=$?
      fi
    else
      "$_func"
      _rc=$?
    fi
    if (( _rc == 0 )); then
      _ok=1
    else
      for _p in "$@"; do
        if [[ $_out == *${_p}* ]]; then _ok=2; break; fi
      done
    fi
    if (( _ok == 1 )); then
      print -- "${_c_green}✓${_c_reset} ${_label} ok ($(( SECONDS - _start ))s)"
    elif (( _ok == 2 )); then
      print -- "${_c_green}✓${_c_reset} ${_label} already current ($(( SECONDS - _start ))s)"
    else
      print -- "${_c_red}✗${_c_reset} ${_label} failed"
      _upd_failed+=("$_label")
    fi
  }
  _upd_if() {  # _upd_if <tool> <label> <function> [ok-pattern ...]
    local _tool=$1 _label=$2 _func=$3
    shift 3
    if command -v "$_tool" >/dev/null; then
      _upd_run "$_label" "$_func" "$@"
    else
      _upd_skipped+=("$_label")
      print -- "${_c_bold}${_c_cyan}━━━ ${_label} ━━━${_c_reset}"
      print -- "  skipped: ${_tool} not installed"
    fi
  }

  # Policy: every non-interactive section runs with stdin closed. Anything that
  # wants confirmation fails fast (red, continue) instead of hanging the run.
  _upd_if brew brew _s_brew
  # omz is a shell function, invisible to `command -v` in this non-interactive
  # script shell. Detect the checkout directly and run the upgrade script as a
  # child process (already isolated - it cannot exec-replace this shell).
  if [[ -f "${ZSH:-$HOME/.oh-my-zsh}/tools/upgrade.sh" ]]; then
    _upd_run oh-my-zsh _s_omz
  else
    _upd_skipped+=("oh-my-zsh")
    print -- "${_c_bold}${_c_cyan}━━━ oh-my-zsh ━━━${_c_reset}"
    print -- "  skipped: oh-my-zsh not installed"
  fi
  _upd_if npm npm-globals _s_npm
  _upd_if bun bun _s_bun
  _upd_if rustup rustup _s_rustup
  # opencode: updating the binary is safe, restarting the service is not.
  # Inside an opencode-hosted terminal (OPENCODE_TERMINAL=1) this shell is a
  # child of the server's PTY. Restarting the server closes the PTY master,
  # this shell gets SIGHUP, and the script dies mid-run.
  _upd_if opencode opencode _s_opencode
  if [[ -n ${OPENCODE_TERMINAL:-} && ${UPD_ALL_RESTART_SERVICE:-0} != 1 ]]; then
    print -- "${_c_bold}${_c_cyan}━━━ opencode-service ━━━${_c_reset}"
    print -- "  skipped: inside an opencode terminal - restarting the service would kill this shell"
    print -- "  run 'opencode service restart' from another shell when you are done"
    _upd_skipped+=("opencode-service")
  else
    _upd_if opencode opencode-service _s_opencode_svc
  fi
  _upd_if claude claude _s_claude
  _upd_if pi pi _s_pi
  _upd_if copilot copilot _s_copilot
  _upd_if crush crush-providers _s_crush
  _upd_if uv uv _s_uv
  _upd_if gh gh-extensions _s_gh
  _upd_if pipx pipx _s_pipx
  if command -v cargo-install-update >/dev/null; then
    _upd_run cargo-packages _s_cargo_pkgs
  else
    _upd_skipped+=("cargo-packages")
    print -- "${_c_bold}${_c_cyan}━━━ cargo-packages ━━━${_c_reset}"
    print -- "  skipped: cargo-install-update not installed (cargo install cargo-update)"
  fi
  # The machine itself is not part of the default run: it needs sudo, sudo
  # reads the password from the terminal, and there is no terminal in every
  # context this script runs from (daemon, cron, ssh without -t, launchd).
  # Opt in with UPD_ALL_OS=1.
  if [[ ${UPD_ALL_OS:-0} == 1 ]]; then
    if ! command -v sudo >/dev/null || ! sudo -v; then
      print -- "${_c_bold}${_c_red}✗${_c_reset} sudo authentication failed - skipping machine updates"
      _upd_failed+=("sudo")
    elif [[ $(uname -s) == Darwin ]]; then
      _upd_run softwareupdate _s_softwareupdate
      _upd_if mas mas _s_mas
    else
      _upd_if apt apt _s_apt
      # release-upgrade stays interactive on purpose - it must never run blind.
      if command -v do-release-upgrade >/dev/null; then
        _upd_run release-upgrade do-release-upgrade 'No new release found' 'no development version'
      else
        _upd_skipped+=("release-upgrade")
        print -- "${_c_bold}${_c_cyan}━━━ release-upgrade ━━━${_c_reset}"
        print -- "  skipped: do-release-upgrade not installed"
      fi
    fi
  else
    if [[ $(uname -s) == Darwin ]]; then
      _upd_skipped+=("softwareupdate mas")
      print -- "${_c_bold}${_c_cyan}━━━ softwareupdate / mas ━━━${_c_reset}"
    else
      _upd_skipped+=("apt release-upgrade")
      print -- "${_c_bold}${_c_cyan}━━━ apt / release-upgrade ━━━${_c_reset}"
    fi
    print -- "  skipped: the machine itself is not updated by default (UPD_ALL_OS=1 to include it)"
  fi
  if (( ${#_upd_skipped} > 0 )); then
    print -- "${_c_bold}${_c_cyan}Skipped sections: ${_upd_skipped[*]}${_c_reset}"
  fi
  if (( ${#_upd_failed} == 0 )); then
    print -- "${_c_bold}${_c_green}All sections passed ✓${_c_reset}"
  else
    print -- "${_c_bold}${_c_red}Failed sections: ${_upd_failed[*]}${_c_reset}"
    return 1
  fi
}

update-all "$@"
